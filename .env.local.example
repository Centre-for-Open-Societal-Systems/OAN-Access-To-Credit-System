API_BASE_URL=
NEXT_PUBLIC_API_MOCKING=false

# Development Agent single sign-on through the OpenG2P IAM service. Optional:
# leave IAM_BASE_URL unset and the Field Agent Portal's SSO button reports
# that sign-in is unavailable. Server-only: the browser never calls IAM; every
# IAM call goes through /api/auth/sso/* and the other /api/auth/* routes.
# IAM must share this app's parent domain so its cookies reach this server.
# IAM_BASE_URL=https://iam.example.org
# The IAM login_providers row id to sign in through. If that row's
# oauth_callback_url is <this app>/api/auth/sso/callback, IAM stays out of the
# browser entirely; otherwise IAM's own callback is used.
# IAM_LOGIN_PROVIDER_ID=1
# The Keycloak client whose roles count. Must equal oan_auth_service's
# iam_application site config, which syncs the same roles onto the local user.
# Development Agents need the client role `A2C Development Agent`.
# IAM_APPLICATION=oan-a2c
# Must match IAM's *_AUTH_COOKIE_PREFIX and *_AUTH_COOKIE_DOMAIN. The prefix is
# how this app finds IAM's cookies by name; the domain is only needed to expire
# them when IAM refuses to renew a session.
# IAM_COOKIE_PREFIX=
# IAM_COOKIE_DOMAIN=.example.org
